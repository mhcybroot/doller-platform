# Database
DB_URL=jdbc:postgresql://localhost:5432/doller
DB_USER=postgres
DB_PASS=change-me

# JWT
# Use a long random secret in real environments.
JWT_ISSUER=doller-platform
JWT_ACTIVE_SECRET=replace-with-a-long-random-secret-value
JWT_PREVIOUS_SECRET=
JWT_ACCESS_EXP_MIN=30
JWT_REFRESH_EXP_DAYS=30

# App
APP_TIMEZONE=Asia/Dhaka
APP_LOGGING_TRADING_DEBUG=false
APP_SECURITY_DOCS_ENABLED=false
APP_AUDIT_STORE_PAYLOADS=false

# First owner bootstrap
# Set APP_INIT_ENABLED=true only for the very first initialization.
# After the first owner is created, set it back to false.
APP_INIT_ENABLED=false
APP_INIT_BOOTSTRAP_TOKEN=replace-with-a-one-time-bootstrap-token
